{
  "name": "port-guardian",
  "version": "0.2.0",
  "description": "Stop debugging port conflicts. Start shipping.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "port-guardian": "./bin/port-guardian.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "port",
    "ports",
    "docker",
    "docker-compose",
    "cli",
    "developer-tools",
    "devtools",
    "process",
    "kill-port",
    "port-conflict"
  ],
  "author": "ki11e6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ki11e6/port-guardian.git"
  },
  "bugs": {
    "url": "https://github.com/ki11e6/port-guardian/issues"
  },
  "homepage": "https://github.com/ki11e6/port-guardian#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "chalk": "^5.3.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^1.6.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  }
}
